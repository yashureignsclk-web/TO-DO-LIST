<!-- Inline Toast Container -->
<div class="fixed bottom-20 left-1/2 -translate-x-1/2 px-4 py-2 rounded-full bg-on-surface text-inverse-on-surface text-label-md font-label-md shadow-xl opacity-0 pointer-events-none transition-all duration-300 z-50 flex items-center gap-2" id="toastNotification">
<span class="material-symbols-outlined text-[18px] text-primary-fixed">info</span>
<span id="toastMessage">Action completed</span>
</div>
</div>
<script>
  (function() {
    const toast = document.getElementById('toastNotification');
    const toastMsg = document.getElementById('toastMessage');

    function showToast(message) {
      if (!toast || !toastMsg) return;
      toastMsg.textContent = message;
      toast.classList.remove('opacity-0', 'translate-y-2', 'pointer-events-none');
      toast.classList.add('opacity-100', 'translate-y-0');
      setTimeout(() => {
        toast.classList.remove('opacity-100', 'translate-y-0');
        toast.classList.add('opacity-0', 'translate-y-2', 'pointer-events-none');
      }, 2600);
    }

    // Toggle Restore / Undo Task Actions
    document.querySelectorAll('.restore-task-action, .toggle-restore-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const row = e.target.closest('.task-card');
        if (!row) return;
        row.style.transform = 'translateX(20px)';
        row.style.opacity = '0';
        setTimeout(() => {
          row.style.display = 'none';
          showToast('Task moved back to active list');
        }, 220);
      });
    });

    // Delete Task permanently
    document.querySelectorAll('.delete-task-action').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const row = e.target.closest('.task-card');
        if (!row) return;
        row.style.transform = 'scale(0.95)';
        row.style.opacity = '0';
        setTimeout(() => {
          row.remove();
          showToast('Task deleted permanently');
        }, 200);
      });
    });

    // Date Filter switching
    const dateButtons = document.querySelectorAll('.filter-date');
    dateButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        dateButtons.forEach(b => {
          b.className = 'filter-date px-3 py-1 rounded-full font-label-md text-label-md bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors';
        });
        btn.className = 'filter-date px-3 py-1 rounded-full font-label-md text-label-md bg-primary text-on-primary shadow-sm transition-colors';
        showToast('Viewing ' + btn.textContent.trim());
      });
    });

    // Category Filter switching
    const catButtons = document.querySelectorAll('.filter-cat');
    catButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const cat = btn.dataset.cat;
        document.querySelectorAll('.task-card').forEach(card => {
          if (cat === 'all' || card.dataset.tag === cat) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
        showToast('Filtered by ' + btn.textContent.trim());
      });
    });

    // Celebration Micro-Interaction
    const confettiBtn = document.getElementById('confettiBtn');
    if (confettiBtn) {
      confettiBtn.addEventListener('click', () => {
        confettiBtn.classList.add('rotate-12', 'scale-110');
        setTimeout(() => confettiBtn.classList.remove('rotate-12', 'scale-110'), 250);
        showToast('Great job staying intentional today!');
      });
    }

    // Batch Action buttons
    const clearBtn = document.getElementById('clearArchiveBtn');
    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        showToast('Cleaned tasks completed > 30 days ago');
      });
    }

    const exportBtn = document.getElementById('exportSummaryBtn');
    if (exportBtn) {
      exportBtn.addEventListener('click', () => {
        showToast('Exported summary report to downloads');
      });
    }
  })();
</script></main><nav class="fixed bottom-0 w-full z-50 pb-safe bg-surface/85 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)]" data-active-classes="text-primary font-label-md"><div class="h-16 max-w-[680px] mx-auto px-space-sm flex items-center justify-around"><a class="flex flex-col items-center justify-center w-16 h-12 text-on-surface-variant hover:text-on-surface transition-colors gap-0.5" data-path="my-day" href="#"><span class="material-symbols-outlined text-[22px]">wb_sunny</span><span class="font-label-sm text-label-sm">My Day</span></a><a class="flex flex-col items-center justify-center w-16 h-12 text-on-surface-variant hover:text-on-surface transition-colors gap-0.5" data-path="upcoming" href="#"><span class="material-symbols-outlined text-[22px]">calendar_today</span><span class="font-label-sm text-label-sm">Upcoming</span></a><a class="flex flex-col items-center justify-center w-16 h-12 text-on-surface-variant hover:text-on-surface transition-colors gap-0.5" data-path="lists-and-projects" href="#"><span class="material-symbols-outlined text-[22px]">folder</span><span class="font-label-sm text-label-sm">Lists</span></a><a aria-current="page" class="flex flex-col items-center justify-center w-16 h-12 transition-colors gap-0.5 text-primary font-label-md" data-path="completed" href="#"><span class="material-symbols-outlined text-[22px]">check_circle</span><span class="font-label-sm text-label-sm">Done</span></a></div></nav></body></html>