<script>
  (function() {
    const btnCreate = document.getElementById('btn-create-list');
    const btnClose = document.getElementById('btn-close-drawer');
    const drawer = document.getElementById('new-list-drawer');
    const searchInput = document.getElementById('project-search-input');
    const btnSubmit = document.getElementById('btn-submit-list');
    const listInput = document.getElementById('new-list-name-input');

    function openDrawer() {
      if (!drawer) return;
      drawer.classList.remove('translate-y-full');
      setTimeout(() => {
        if (listInput) listInput.focus();
      }, 150);
    }

    function closeDrawer() {
      if (!drawer) return;
      drawer.classList.add('translate-y-full');
      if (listInput) listInput.value = '';
    }

    if (btnCreate) btnCreate.addEventListener('click', openDrawer);
    if (btnClose) btnClose.addEventListener('click', closeDrawer);
    if (btnSubmit) btnSubmit.addEventListener('click', closeDrawer);

    // Interactive Tag click toggle
    const tags = document.querySelectorAll('.tag-pill');
    tags.forEach(tag => {
      tag.addEventListener('click', () => {
        tag.classList.toggle('ring-2');
        tag.classList.toggle('ring-primary/30');
      });
    });

    // Real-time simple filter simulation
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase();
        const cards = document.querySelectorAll('.group');
        cards.forEach(card => {
          const text = card.textContent.toLowerCase();
          if (text.includes(query)) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    }
  })();
