<script>
  (function () {
    // Quick Add interactions
    const addInput = document.getElementById('quick-add-input');
    const addBtn = document.getElementById('quick-add-submit-btn');
    const activeTasksContainer = document.getElementById('active-tasks-list');
    const chipPriority = document.getElementById('chip-priority');
    const chipPriorityText = document.getElementById('chip-priority-text');
    const chipDue = document.getElementById('chip-due');
    const chipDueText = document.getElementById('chip-due-text');
    const chipTag = document.getElementById('chip-tag');
    const chipTagText = document.getElementById('chip-tag-text');

    const priorities = [
      { label: 'High', bg: 'bg-error-container/60 hover:bg-error-container', text: 'text-on-error-container' },
      { label: 'Medium', bg: 'bg-surface-container-high hover:bg-surface-container-highest', text: 'text-on-secondary-fixed-variant' },
      { label: 'Low', bg: 'bg-secondary-fixed/40 hover:bg-secondary-fixed/70', text: 'text-on-secondary-fixed-variant' }
    ];
    let priorityIndex = 0;

    chipPriority?.addEventListener('click', () => {
      priorityIndex = (priorityIndex + 1) % priorities.length;
      chipPriorityText.textContent = priorities[priorityIndex].label;
    });

    const dates = ['Today', 'Tomorrow', 'This Friday'];
    let dateIndex = 0;
    chipDue?.addEventListener('click', () => {
      dateIndex = (dateIndex + 1) % dates.length;
      chipDueText.textContent = dates[dateIndex];
    });

    const tags = ['#Work', '#Personal', '#Focus', '#Ideas'];
    let tagIndex = 0;
    chipTag?.addEventListener('click', () => {
      tagIndex = (tagIndex + 1) % tags.length;
      chipTagText.textContent = tags[tagIndex];
    });

    function addNewTask() {
      const val = addInput.value.trim();
      if (!val) return;

      const card = document.createElement('div');
      card.className = 'task-card group relative flex items-start gap-3 p-3.5 bg-surface-container-lowest rounded-xl shadow-xs transition-all hover:bg-surface-bright animate-fadeIn';
      card.innerHTML = `
        <button class="task-checkbox mt-0.5 w-5 h-5 rounded-full bg-surface-container-high flex items-center justify-center text-transparent hover:text-primary transition-colors shrink-0" aria-label="Mark task done">
          <span class="material-symbols-outlined text-[16px] leading-none">check</span>
        </button>
        <div class="flex-1 min-w-0">
          <div class="flex items-baseline justify-between gap-2">
            <p class="task-title font-body-md text-body-md text-on-surface font-medium truncate">${val}</p>
            <button class="opacity-0 group-hover:opacity-100 text-outline hover:text-on-surface transition-opacity shrink-0" aria-label="Favorite task">
              <span class="material-symbols-outlined text-[18px]">star</span>
            </button>
          </div>
          <div class="flex flex-wrap items-center gap-2 mt-1.5">
            <span class="inline-flex items-center gap-1 font-label-sm text-label-sm text-primary font-medium">
              <span class="material-symbols-outlined text-[13px]">schedule</span>
              ${chipDueText.textContent}
            </span>
            <span class="inline-flex items-center px-2 py-0.5 rounded-full font-label-sm text-label-sm bg-surface-container-high text-on-secondary-fixed-variant font-medium">
              ${chipPriorityText.textContent} Priority
            </span>
            <span class="inline-flex items-center px-2 py-0.5 rounded-full font-label-sm text-label-sm bg-surface-container text-on-surface-variant font-medium">
              ${chipTagText.textContent}
            </span>
          </div>
        </div>
        <div class="opacity-0 group-hover:opacity-100 flex items-center gap-1 transition-opacity shrink-0">
          <button class="p-1 rounded-md text-outline hover:text-on-surface hover:bg-surface-container transition-colors" aria-label="Task options">
            <span class="material-symbols-outlined text-[16px]">more_vert</span>
          </button>
        </div>
      `;

      activeTasksContainer.appendChild(card);
      addInput.value = '';
      wireCheckboxes();
      updateCounts();
    }

    addBtn?.addEventListener('click', addNewTask);
    addInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        addNewTask();
      }
    });

    // Toggle completed accordion
    const completedToggleBtn = document.getElementById('completed-toggle-btn');
    const completedList = document.getElementById('completed-list');
    const completedIcon = document.getElementById('completed-toggle-icon');

    completedToggleBtn?.addEventListener('click', () => {
      const isHidden = completedList.classList.toggle('hidden');
      completedIcon.style.transform = isHidden ? 'rotate(-90deg)' : 'rotate(0deg)';
    });

    // Checkbox toggling
    function wireCheckboxes() {
      document.querySelectorAll('.task-checkbox').forEach((btn) => {
        btn.onclick = function () {
          const card = this.closest('.task-card');
          if (!card) return;
          const title = card.querySelector('.task-title')?.textContent || 'Task';
          card.classList.add('opacity-0', 'scale-95');
          setTimeout(() => {
            card.remove();
            addToCompleted(title);
            updateCounts();
          }, 250);
        };
      });

      document.querySelectorAll('.task-uncheck-btn').forEach((btn) => {
        btn.onclick = function () {
          const card = this.closest('.completed-card');
          if (!card) return;
          card.remove();
          updateCounts();
        };
      });
    }

    function addToCompleted(title) {
      const completedCard = document.createElement('div');
      completedCard.className = 'completed-card flex items-center gap-3 p-3 bg-surface-container-low/70 rounded-xl transition-all';
      completedCard.innerHTML = `
        <button class="task-uncheck-btn w-5 h-5 rounded-full bg-primary text-on-primary flex items-center justify-center shrink-0 shadow-xs" aria-label="Undo completed task">
          <span class="material-symbols-outlined text-[14px]">done</span>
        </button>
        <div class="flex-1 min-w-0">
          <p class="font-body-md text-body-md text-outline line-through truncate">${title}</p>
        </div>
        <span class="font-label-sm text-label-sm text-outline shrink-0">Just now</span>
      `;
      completedList.prepend(completedCard);
      wireCheckboxes();
    }

    function updateCounts() {
      const activeCards = document.querySelectorAll('.task-card').length;
      const doneCards = document.querySelectorAll('.completed-card').length;
      const total = activeCards + doneCards;
      const countEl = document.getElementById('active-count-label');
      if (countEl) countEl.textContent = `${activeCards} tasks remaining`;
      const badge = document.getElementById('completed-badge');
      if (badge) badge.textContent = doneCards;

      if (total > 0) {
        const pct = Math.round((doneCards / total) * 100);
        const barFill = document.getElementById('progress-bar-fill');
        if (barFill) barFill.style.width = pct + '%';
        const ring = document.getElementById('streak-progress-ring');
        if (ring) {
          const maxOffset = 113.1;
          const offset = maxOffset - (maxOffset * pct) / 100;
          ring.setAttribute('stroke-dashoffset', offset);
        }
      }
    }

    // Filter switching
    const filterButtons = document.querySelectorAll('.filter-btn');
    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterButtons.forEach((b) => {
          b.className = 'filter-btn px-3 py-1.5 rounded-full font-label-md text-label-md bg-surface-container text-on-surface-variant hover:bg-surface-container-high font-medium transition-colors';
        });
        btn.className = 'filter-btn px-3 py-1.5 rounded-full font-label-md text-label-md bg-primary text-on-primary font-semibold shadow-xs transition-colors';

        const filter = btn.getAttribute('data-filter');
        const activeSection = document.getElementById('active-tasks-list');
        const compSection = document.getElementById('completed-section');

        if (filter === 'all') {
          activeSection.classList.remove('hidden');
          compSection.classList.remove('hidden');
        } else if (filter === 'active') {
          activeSection.classList.remove('hidden');
          compSection.classList.add('hidden');
        } else if (filter === 'completed') {
          activeSection.classList.add('hidden');
          compSection.classList.remove('hidden');
        }
      });
    });

    // Initial setup
    wireCheckboxes();
  })();
